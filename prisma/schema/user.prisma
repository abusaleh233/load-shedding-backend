model User {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  password      String
  phone         String?
  role          UserRole      @default(CONSUMER)
  status        AccountStatus @default(ACTIVE)
  consumerId    String?       @unique
  meterNumber   String?       @unique
  meterType     MeterType?    @default(PREPAID)
  areaId        String?
  area          Area?         @relation(fields: [areaId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  bills         Bill[]
  payments      Payment[]
  auditLogs     AuditLog[]

  @@map("users")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}